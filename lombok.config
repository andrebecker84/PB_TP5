# Instrui o Lombok a marcar todo código gerado com @lombok.Generated.
# O JaCoCo 0.8.x e o SonarCloud reconhecem essa anotação e excluem o código
# gerado do cálculo de cobertura, alinhando a métrica do SonarCloud com o
# gate local do jacoco:check.
config.stopBubbling = true
lombok.addLombokGeneratedAnnotation = true
